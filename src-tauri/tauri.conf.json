{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TodoEdge",
  "version": "1.2.0-beta.2",
  "identifier": "com.todoedge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TodoEdge",
        "width": 6,
        "height": 432,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "skipTaskbar": true,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
